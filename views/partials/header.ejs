<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · New to Hong Kong Guide</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/">New to <span>Hong Kong</span></a>
    <nav aria-label="Main navigation">
      <% if (currentUser) { %>
        <a href="/posts">Posts</a>
        <a href="/posts/new">New post</a>
        <span class="username"><%= currentUser.displayName %></span>
        <form action="/logout" method="post" class="inline-form"><button class="text-button" type="submit">Log out</button></form>
      <% } else { %>
        <a href="/login">Log in</a>
        <a href="/register">Register</a>
      <% } %>
    </nav>
  </header>
  <main class="container">
